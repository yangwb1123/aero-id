{
  "name": "aero-id-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "check:iris-imports": "node scripts/verify-iris-imports.mjs",
    "format:check": "prettier --check src scripts README.md index.html package.json",
    "check": "pnpm check:iris-imports && pnpm test && pnpm lint && pnpm typecheck && pnpm format:check && pnpm build",
    "dev:iris": "IRIS_UI_SOURCE=1 vite",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@iris-ui-kit/plugin-locale-zh": "^0.1.0",
    "@iris-ui-kit/react": "^0.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "10.0.1",
    "globals": "17.11.0",
    "jsdom": "25.0.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "6.4.3",
    "vitest": "3.2.6"
  },
  "packageManager": "pnpm@10.34.5"
}
