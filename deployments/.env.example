# Copy to the repository-root .env (git-ignored), chmod 600, and fill secrets.
# Snaplink must already exist and be reachable from inside the containers.
POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
AERO_ID_SIGNING_KEY=
AERO_ID_AUDIT_LEDGER_SIGNING_KEY=

# Replace these public endpoints/identifiers with your registered deployment.
AERO_ID_SSO_ENDPOINT=snaplink.example.com:443
AERO_ID_SSO_JWKS_URL=https://snaplink.example.com/.well-known/jwks.json
AERO_ID_SSO_ISSUER=https://snaplink.example.com
AERO_ID_SSO_AUDIENCE=aero-id
AERO_ID_SSO_AUTHZ_CLIENT_ID=aero-id
AERO_ID_SSO_INSECURE=false
AERO_ID_SERVER_HTTP_CORS_ORIGINS=http://localhost:5180

# Optional capabilities: leave disabled until keys/contracts are provisioned.
AERO_ID_EXPORT_ENCRYPTION_KEY=
AERO_ID_CALLBACK_MASTER_KEY=
